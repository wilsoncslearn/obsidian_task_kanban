{
  "name": "lubi",
  "version": "1.8.0",
  "description": "柳比歇夫时间记录：记录 · 回顾 · 任务",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vault": "node esbuild.config.mjs --vault",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:vault": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production --vault",
    "check:dist": "npm run build && node scripts/check-dist.mjs",
    "test:build": "node esbuild.config.mjs production && node scripts/build-tests.mjs",
    "test:core": "node scripts/build-tests.mjs core && node --test \"test/core/*.mjs\"",
    "test:smoke": "npm run test:build && node --test \"test/smoke/*.mjs\"",
    "test:layout": "npm run test:build && node test/helpers/preview.mjs && node --test --test-concurrency=1 \"test/layout/*.mjs\"",
    "test": "npm run test:core && npm run test:smoke && npm run test:layout"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "jsdom": "^24.1.3",
    "lucide-static": "^1.48.0",
    "obsidian": "1.14.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
